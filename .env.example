# ── C7X multi-tenant platform ──────────────────────────────────────
# Mode: local | production
# HELIX_* names still work as aliases
C7X_ENV=local
C7X_SECRET_KEY=change-me-to-a-long-random-string
C7X_BASE_URL=http://localhost:8000

# Database: sqlite for local, postgres for VPS
# DATABASE_URL=sqlite:///./data/helix.db
DATABASE_URL=postgresql+psycopg2://helix:helix@db:5432/helix

# OpenRouter — JUDGING only (verify, review, strategy). Never used for scraping.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.5
# Optional site attribution for OpenRouter rankings
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_SITE_NAME=C7X

# Apify — GATHERING only (search + page fetch). Required for real-world mining.
# Console: https://console.apify.com/account/integrations
APIFY_API_KEY=apify_api_xxxx
# APIFY_TOKEN=   # optional alias
APIFY_MAX_RESULTS_PER_SEARCH=10
APIFY_DEDUPE_HOURS=48
APIFY_CACHE_HOURS=24
APIFY_DEFAULT_TIMEOUT_SECS=120
APIFY_FAIL_CLOSED=true

# Bootstrap super-admin (created on first boot if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Resend — account emails only (verify, reset password, invites)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=C7X <onboarding@resend.dev>
# RESEND_REPLY_TO=support@your-domain.com

# Hostinger Agentic Mail — Riu's inbox (not the hosting/VPS token)
# hPanel → Emails → [domain] → Agentic mail → API
HOSTINGER_MAIL_API_TOKEN=
# Optional. If omitted, C7X uses the token's mailbox (or the one matching RIU_MAILBOX_ADDRESS).
# HOSTINGER_MAIL_MAILBOX_ID=ACxxxxxxxx
RIU_MAILBOX_ADDRESS=Riu <hello@c7xai.in>
# RIU_MAILBOX_FROM_EMAIL=Riu <hello@c7xai.in>
# RIU_MAILBOX_ALLOWED_SENDERS=you@example.com,@yourcompany.com
# Optional. Only needed for instant push. Riu can list/send/reply with the API token alone.
# HOSTINGER_MAIL_WEBHOOK_SECRET=

# Auth policy
ALLOW_PUBLIC_SIGNUP=true
REQUIRE_EMAIL_VERIFICATION=true
AUTO_CREATE_WORKSPACE_ON_SIGNUP=true
AUTH_TOKEN_EXPIRE_HOURS=24

# Agent runtime
MAX_TOOL_ROUNDS=12
DEFAULT_TENANT_MONTHLY_BUDGET_USD=50

# User library defaults (indefinite storage in each user account)
DEFAULT_GOLD_TARGET_COUNT=5000
DEFAULT_VARIATIONS_PER_GOLD=4
MAX_SYNTHESIS_BATCH_GOLDS=50
MAX_VARIATIONS_PER_GOLD=20

# Optional: allow local direct xAI when OPENROUTER_API_KEY is unset
# XAI_API_KEY=
